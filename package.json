{
  "name": "omnicast",
  "version": "1.5.1",
  "type": "module",
  "homepage": "https://zubiaks.github.io/omnicast",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "scripts": {
    "setup": "npm install --no-audit --omit=optional && npx playwright install --with-deps",
    "dev": "vite",
    "dev:ci": "vite --port 5500 --clearScreen false",
    "build": "vite build",
    "preview": "vite preview",
    "serve:dist": "serve -s dist -l 5500",
    "test:rls": "node scripts/test-rls.js",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:report": "npx playwright show-report",
    "test": "npm run test:rls && npm run test:e2e",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "release": "semantic-release"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "@supabase/supabase-js": "^2.58.0",
    "dotenv": "^17.2.3",
    "express-prom-bundle": "^8.0.0",
    "hls.js": "^1.6.13",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "gh-pages": "^6.3.0",
    "jsonlint": "^1.6.3",
    "puppeteer": "^24.26.1",
    "semantic-release": "^24.2.9",
    "serve": "^14.2.5",
    "snyk": "^1.1299.1",
    "vite": "^7.1.8",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-tsconfig-paths": "^1.4.1"
  },
  "overrides": {
    "tmp": "^0.2.4",
    "underscore": "^1.13.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zubiaks/omnicast.git"
  },
  "bugs": {
    "url": "https://github.com/zubiaks/omnicast/issues"
  },
  "license": "MIT"
}
